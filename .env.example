# Pick ONE provider key. LLM_PROVIDER=auto uses the first key it finds.
GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=       (also set LLM_MODEL)
# OPENROUTER_API_KEY=     (also set LLM_MODEL)
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
# LLM_MODEL=              # override the provider's default model
# LLM_BASE_URL=           # only for LLM_PROVIDER=custom (or a proxy)
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
ADMIN_TOKEN=change-me
STATE_DIR=./var
